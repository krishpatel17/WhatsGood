    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "pdfjs-dist": "^6.5.438",
    "playwright-core": "^1.64.1",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.156.2",
    "yaml": "^2.9.1"
